#!/usr/bin/env node

const args = process.argv.slice(2);
if (args[0] !== "models") {
  console.error("expected models command");
  process.exit(2);
}
if (process.env.GEMINI_API_KEY) {
  console.error("GEMINI_API_KEY leaked into model discovery");
  process.exit(9);
}

if (args.includes("--output-format")) {
  if (process.env.FAKE_AGY_JSON_UNSUPPORTED === "1") {
    console.error("unknown option --output-format");
    process.exit(2);
  }
  console.log(
    JSON.stringify({
      models: [
        { id: "gemini-3.7-flash-low", displayName: "Flash low" },
        { model: "gemini-3.7-flash-high", displayName: "Flash high" },
      ],
    }),
  );
  process.exit(0);
}

console.log(`MODEL DESCRIPTION
* gemini-3.1-pro-low Pro low
  gemini-3.1-pro-high Pro high`);
