#!/usr/bin/env node
import { spawn } from "node:child_process";

const args = process.argv.slice(2);
const promptIndex = args.indexOf("-p");
if (promptIndex < 0 || !args[promptIndex + 1]) {
  console.error("missing prompt");
  process.exit(2);
}
const prompt = args[promptIndex + 1];

if (prompt.includes("FAKE:INVALID")) {
  console.log("not-json");
  process.exit(0);
}
if (prompt.includes("FAKE:SLEEP")) {
  setInterval(() => {}, 1_000);
  continueForever();
}
if (prompt.includes("FAKE:CHILD")) {
  const child = spawn(process.execPath, ["-e", "setInterval(()=>{},1000)"], { stdio: "ignore" });
  console.error(`child-pid=${child.pid}`);
  setInterval(() => {}, 1_000);
  continueForever();
}

const structured = { text: "ok", tool_calls: [], finish_reason: "stop" };
console.log(JSON.stringify({
  event: "init",
  conversation_id: "fake-conversation",
  init: {
    cwd: process.cwd(),
    tools: [],
    permission_mode: "request-review",
    model: args.includes("--model") ? args[args.indexOf("--model") + 1] : "default",
    agent: args.includes("--agent") ? args[args.indexOf("--agent") + 1] : "default",
  },
}));

if (prompt.includes("FAKE:TOOL")) {
  console.log(JSON.stringify({
    event: "step_update",
    step_update: {
      conversation_id: "fake-conversation",
      step_index: 1,
      state: "DONE",
      step_type: "tool",
      tool_name: "read_file",
      tool_info: { name: "read_file", parameters: { path: "README.md" }, output: "ok" },
      subagent_info: { subagents: [{ role: "reviewer", conversation_id: "child-1" }] },
    },
  }));
}

if (prompt.includes("FAKE:ERROR")) {
  console.log(JSON.stringify({
    event: "result",
    result: { status: "ERROR", error: "fake failure" },
  }));
  process.exit(1);
}

console.log(JSON.stringify({
  event: "step_update",
  step_update: {
    conversation_id: "fake-conversation",
    step_index: 2,
    state: "DONE",
    step_type: "agent_response",
    text_delta: JSON.stringify(structured),
  },
}));
console.log(JSON.stringify({
  event: "result",
  result: {
    conversation_id: "fake-conversation",
    status: "SUCCESS",
    response: JSON.stringify(structured),
    structured_output: structured,
    duration_seconds: 0.1,
    num_turns: 1,
    usage: { input_tokens: 10, output_tokens: 4, thinking_tokens: 0, cache_read_tokens: 2, total_tokens: 14 },
  },
}));

function continueForever() {
  // Keeps the process alive until the bridge aborts or times out.
}
