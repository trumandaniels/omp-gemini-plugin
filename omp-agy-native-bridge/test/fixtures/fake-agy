#!/usr/bin/env node
import { spawn } from "node:child_process";

const args = process.argv.slice(2);
const promptIndex = args.indexOf("-p");
let prompt = "";
if (promptIndex >= 0 && args[promptIndex + 1]) {
  prompt = args[promptIndex + 1];
} else {
  process.stdin.setEncoding("utf8");
  for await (const chunk of process.stdin) prompt += chunk;
}
if (!prompt) {
  console.error("missing prompt");
  process.exit(2);
}
const plain = prompt.includes("FAKE:PLAIN");

if (prompt.includes("FAKE:INVALID")) {
  console.log("not-json");
  process.exit(0);
}
if (prompt.includes("FAKE:SLEEP")) {
  setInterval(() => {}, 1_000);
  continueForever();
}
if (prompt.includes("FAKE:CHILD")) {
  const child = spawn(process.execPath, ["-e", "setInterval(()=>{},1000)"], { stdio: "ignore" });
  console.error(`child-pid=${child.pid}`);
  setInterval(() => {}, 1_000);
  continueForever();
}

const correctedMissingRecipient = prompt.includes("Mandatory provider routing correction")
  || prompt.includes("Provider mode has no internal messaging return path");
const structured = {
  response: prompt.includes("FAKE:MISSING_OMP_RECIPIENT") && correctedMissingRecipient
    ? "recovered without AGY messaging"
    : "ok",
  host_requests: [],
};
console.log(
  JSON.stringify({
    event: "init",
    conversation_id: "fake-conversation",
    init: {
      cwd: process.cwd(),
      tools: [],
      permission_mode: "request-review",
      add_dirs: args.flatMap((arg, index) => arg === "--add-dir" ? [args[index + 1]] : []),
      model: args.includes("--model") ? args[args.indexOf("--model") + 1] : "default",
      agent: args.includes("--agent") ? args[args.indexOf("--agent") + 1] : "default",
    },
  }),
);

if (prompt.includes("FAKE:TOOL")) {
  console.log(
    JSON.stringify({
      event: "step_update",
      step_update: {
        conversation_id: "fake-conversation",
        step_index: 1,
        state: "DONE",
        step_type: "tool",
        tool_name: "read_file",
        tool_info: { name: "read_file", parameters: { path: "README.md" }, output: "ok" },
        subagent_info: { subagents: [{ role: "reviewer", conversation_id: "child-1" }] },
      },
    }),
  );
}

if (prompt.includes("FAKE:MISSING_OMP_RECIPIENT") && !correctedMissingRecipient) {
  for (const state of ["ACTIVE", "DONE"]) {
    console.log(
      JSON.stringify({
        event: "step_update",
        step_update: {
          conversation_id: "fake-conversation",
          step_index: 7,
          state,
          step_type: "tool",
          tool_name: "send_message",
          tool_info: {
            name: "send_message",
            parameters: { recipient: "omp", message: "continue" },
            ...(state === "DONE"
              ? { error: { type: "not_found", message: 'recipient "omp" not found' } }
              : {}),
          },
        },
      }),
    );
  }
  console.log(
    JSON.stringify({
      event: "result",
      result: {
        conversation_id: "fake-conversation",
        status: "ERROR",
        error: 'recipient "omp" not found',
        usage: {
          input_tokens: 5,
          output_tokens: 1,
          thinking_tokens: 1,
          cache_read_tokens: 0,
          total_tokens: 7,
        },
      },
    }),
  );
  process.exit(1);
}

if (prompt.includes("FAKE:ERROR")) {
  console.log(
    JSON.stringify({
      event: "result",
      result: { status: "ERROR", error: "fake failure" },
    }),
  );
  process.exit(1);
}

const responseText = plain ? "plain provider response" : JSON.stringify(structured);
if (!plain) {
  console.log(
    JSON.stringify({
      event: "step_update",
      step_update: {
        conversation_id: "fake-conversation",
        step_index: 2,
        state: "DONE",
        step_type: "agent_response",
        text_delta: responseText,
      },
    }),
  );
}

const terminal = {
  conversation_id: "fake-conversation",
  status: "SUCCESS",
  response: responseText,
  ...(plain ? {} : { structured_output: structured }),
  duration_seconds: 0.1,
  num_turns: 1,
  usage: {
    input_tokens: 10,
    output_tokens: 4,
    thinking_tokens: 0,
    cache_read_tokens: 2,
    total_tokens: 16,
  },
};
console.log(JSON.stringify({ event: "result", result: terminal }));

if (prompt.includes("FAKE:DUPLICATE_RESULT")) {
  console.log(JSON.stringify({ event: "result", result: terminal }));
}
if (prompt.includes("FAKE:CONFLICTING_RESULT")) {
  console.log(
    JSON.stringify({
      event: "result",
      result: { ...terminal, response: "conflicting terminal", structured_output: { response: "conflict", host_requests: [] } },
    }),
  );
}

function continueForever() {
  // Keeps the process alive until the bridge aborts or times out.
}
